# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff format's indent, which pyproject.toml follows too
[{*.py,*.pyi,pyproject.toml}]
indent_size = 4

# rustfmt's default indent
[*.rs]
indent_size = 4
# shared:if repo=homebrew-tap

# brew style owns these scripts' layout (`then` and `do` on their own line),
# which plain shfmt would undo; shfmt honors `ignore` only when it walks a
# directory, so a format-on-save of one file must skip what `shfmt -f .` skips
[docs/tapes/*.sh]
ignore = true
# shared:endif
