# Every text file checks out LF on every platform. Git for Windows defaults
# core.autocrlf=true and actions/checkout does not override it, so without
# this a Windows checkout would hold CRLF shell scripts.
* text=auto eol=lf
# Images and packages are never text, whatever text=auto's sniffing guesses:
# no eol conversion and no textual diff. One pattern per line, which is all
# gitattributes accepts.
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
# shared:if repo=python-constricter
# GitHub fills in the tag for a tarball of a commit, as when a workflow uses the action: its
# version without git history.
.git_archival.txt export-subst
# shared:endif
