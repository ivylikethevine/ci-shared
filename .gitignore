# Everything generated on this machine (scratch, tool caches, local builds).
local/

# npm installs, the pinned CI Markdown tools' (.github/package.json) included.
node_modules/

# Claude Code: personal overrides, agent worktrees and host-specific agent
# notes stay local.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
# Claude Code's sandbox bind-mounts /dev/null over these denied paths while a
# session runs; none is a file of this repo
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/launch.json
/.claude/loop.md
/.claude/output-styles
/.claude/routines
/.claude/scheduled_tasks.json
/.claude/skills
/.claude/workflows
/.claude/.cc-writes
# the device alone: a .vscode/ directory, the shared one under files/, stays
/.vscode
!/.vscode/
# .claude/settings.json too: where it is tracked the ignore changes nothing,
# and where it is not the device would show as untracked
/.claude/settings.json

# Secrets and local environment. A .env.example is a template with no real
# values, so it stays tracked.
.env
.env.*
!.env.example
.envrc
.direnv/
*.key
*.pem
*.pfx
*.crt
*.cert
*.pub
*.rsa
*.priv
secret/
secrets/
private/
keys/

# Editor and OS droppings, and the backups merge tools leave beside a conflict.
.DS_Store
*.swp
*.swo
*~
*.orig

# Logs.
*.log

# Python's bytecode caches and packaging metadata, and Hypothesis's example
# database.
__pycache__/
*.pyc
*.egg-info/
.hypothesis/
.import_linter_cache/
# Packaging output at the root; a build/ deeper in the tree is source.
/build/
/dist/
# Rust build output.
/target
**/*.rs.bk
# A local Jekyll build of the docs site; CI builds the real one.
_site/
.jekyll-cache/
