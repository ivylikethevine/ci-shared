# The common part of files/.gitignore by hand: git does not follow a symlinked
# .gitignore.

# Everything generated on this machine (scratch, tool caches, local builds).
local/

# npm installs, the pinned CI Markdown tools' (.github/package.json) included.
node_modules/

# Claude Code: .claude/settings.json is shared and tracked; personal overrides,
# agent worktrees and host-specific agent notes stay local.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
# Claude Code's sandbox bind-mounts /dev/null over these denied paths while a
# session runs; none is a file of this repo
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/launch.json
/.claude/loop.md
/.claude/output-styles
/.claude/routines
/.claude/scheduled_tasks.json
/.claude/skills
/.claude/workflows
/.claude/.cc-writes
/.vscode
# .claude/settings.json too: this repository tracks none, so the device would
# show as untracked
/.claude/settings.json

# Secrets and local environment. A .env.example is a template with no real
# values, so it stays tracked.
.env
.env.*
!.env.example
.envrc
.direnv/
*.key
*.pem
*.pfx
*.crt
*.cert

# Editor and OS droppings, and the backups merge tools leave beside a conflict.
.DS_Store
*.swp
*.swo
*~
*.orig
